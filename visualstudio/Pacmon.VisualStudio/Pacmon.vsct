      </Button>
      <Button guid="guidPacmonCommands" id="ShowCoverage" priority="0x0300" type="Button">
        <Parent guid="guidPacmonCommands" id="PacmonMenuGroup" />
        <Strings><ButtonText>Documentation Coverage</ButtonText></Strings>
      </Button>
      <Button guid="guidPacmonCommands" id="NormalizeNotes" priority="0x0400" type="Button">
        <Parent guid="guidPacmonCommands" id="PacmonMenuGroup" />
        <Strings><ButtonText>Format NuGet Dependency Notes</ButtonText></Strings>
      </Button>
      <Button guid="guidPacmonCommands" id="SetupAiInstructions" priority="0x0500" type="Button">
        <Parent guid="guidPacmonCommands" id="PacmonMenuGroup" />
        <Strings><ButtonText>Set Up AI Instructions</ButtonText></Strings>
      </Button>
      <Button guid="guidPacmonCommands" id="ToggleMarkers" priority="0x0600" type="Button">
        <Parent guid="guidPacmonCommands" id="PacmonMenuGroup" />
        <Strings><ButtonText>Toggle Note Markers</ButtonText></Strings>
      </Button>
    </Buttons>
  </Commands>
