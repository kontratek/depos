  <Commands package="guidPacmonPackage">
    <Groups>
      <Group guid="guidPacmonCommands" id="PacmonMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidPacmonCommands" id="PacmonEditorGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
    </Groups>
    <Buttons>
      <Button guid="guidPacmonCommands" id="ShowPacmon" priority="0x0100" type="Button">
        <Parent guid="guidPacmonCommands" id="PacmonMenuGroup" />
        <Strings><ButtonText>Depos Dependency Notes</ButtonText></Strings>
      </Button>
      <Button guid="guidPacmonCommands" id="AddOrEditNote" priority="0x0100" type="Button">
        <Parent guid="guidPacmonCommands" id="PacmonEditorGroup" />
        <Strings><ButtonText>Depos: Add/Edit Dependency Note</ButtonText></Strings>
      </Button>
      <Button guid="guidPacmonCommands" id="OpenNotes" priority="0x0200" type="Button">
        <Parent guid="guidPacmonCommands" id="PacmonMenuGroup" />
        <Strings><ButtonText>Open NuGet Dependency Notes</ButtonText></Strings>
      </Button>
      <Button guid="guidPacmonCommands" id="OpenManifest" priority="0x0250" type="Button">
        <Parent guid="guidPacmonCommands" id="PacmonMenuGroup" />
