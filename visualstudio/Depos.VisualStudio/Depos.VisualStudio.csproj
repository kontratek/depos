<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <DeployExtension>false</DeployExtension>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DeposVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\package.json')), '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</DeposVersion>
    <VsixId>dev.depos.visualstudio</VsixId>
    <VsixVersion>$(DeposVersion)</VsixVersion>
    <VsixPublisher>Kontra</VsixPublisher>
    <VsixDisplayName>Depos — Dependency Notes</VsixDisplayName>
    <VsixDescription>Why each .NET/NuGet dependency exists, stored as plain Markdown in your repository.</VsixDescription>
    <AssemblyName>Depos.VisualStudio</AssemblyName>
    <RootNamespace>Depos.VisualStudio</RootNamespace>
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\$(TargetFramework)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetVsixContainerName>depos-visualstudio.vsix</TargetVsixContainerName>
    <TargetVsixContainer>$(OutputPath)$(TargetVsixContainerName)</TargetVsixContainer>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Design" />
    <Reference Include="System.ComponentModel.Composition" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Depos.Core\Depos.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="source.extension.vsixmanifest" />
    <Content Include="source.extension.vsixmanifest" />
    <SourceVsixManifest Include="$(IntermediateOutputPath)source.extension.vsixmanifest" />
    <Content Include="..\..\media\icon.png" Link="Assets\pacmon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\..\LICENSE" Link="LICENSE">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <VSCTCompile Include="Depos.vsct" />
  </ItemGroup>
  <Target Name="GenerateDeposVsixManifest" BeforeTargets="DetokenizeVsixManifestFile">
    <PropertyGroup>
      <GeneratedVsixManifest>$(IntermediateOutputPath)source.extension.vsixmanifest</GeneratedVsixManifest>
    </PropertyGroup>
    <Copy SourceFiles="source.extension.vsixmanifest" DestinationFiles="$(GeneratedVsixManifest)" />
    <XmlPoke XmlInputPath="$(GeneratedVsixManifest)"
             Query="/*[local-name()='PackageManifest']/*[local-name()='Metadata']/*[local-name()='Identity']/@Version"
             Value="$(DeposVersion)" />
    <ItemGroup><FileWrites Include="$(GeneratedVsixManifest)" /></ItemGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>
