<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="dev.pacmon.visualstudio" Version="0.0.0" Language="en-US" Publisher="Kontra" />
    <DisplayName>Depos (formerly Pacmon) — Dependency Notes</DisplayName>
    <Description xml:space="preserve">Why each .NET/NuGet dependency exists, stored as plain Markdown in your repository.</Description>
    <MoreInfo>https://depos.dev</MoreInfo>
    <License>LICENSE</License>
    <ReleaseNotes>https://github.com/kontratek/depos/blob/main/CHANGELOG.md</ReleaseNotes>
    <Icon>Assets\icon.png</Icon>
    <Tags>dependencies;documentation;NuGet;.NET;PackageReference;security;allowlist;supply chain;pacmon</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies />
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgDefProjectOutputGroup|" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;BuiltProjectOutputGroup|" />
  </Assets>
</PackageManifest>
