<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <!-- The GUIDs and ids are the ones from before Pacmon became Depos, so what
       Visual Studio keeps under them carries over to this version. -->
  <Commands package="guidDeposPackage">
    <Menus>
      <!-- Tools > Depos, as in the JetBrains plugin: the notes commands, then the organization ones. -->
      <Menu guid="guidDeposCommands" id="DeposMenu" priority="0x0100" type="Menu">
        <Parent guid="guidDeposCommands" id="DeposToolsGroup" />
        <Strings><ButtonText>Depos</ButtonText></Strings>
      </Menu>
    </Menus>
    <Groups>
      <Group guid="guidDeposCommands" id="DeposToolsGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidDeposCommands" id="DeposMenuGroup" priority="0x0100">
        <Parent guid="guidDeposCommands" id="DeposMenu" />
      </Group>
      <Group guid="guidDeposCommands" id="DeposConnectionGroup" priority="0x0200">
        <Parent guid="guidDeposCommands" id="DeposMenu" />
      </Group>
      <Group guid="guidDeposCommands" id="DeposEditorGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
    </Groups>
    <Buttons>
      <Button guid="guidDeposCommands" id="ShowDepos" priority="0x0100" type="Button">
        <Parent guid="guidDeposCommands" id="DeposMenuGroup" />
        <Strings><ButtonText>Depos Dependency Notes</ButtonText></Strings>
      </Button>
      <Button guid="guidDeposCommands" id="AddOrEditNote" priority="0x0100" type="Button">
        <Parent guid="guidDeposCommands" id="DeposEditorGroup" />
        <Strings><ButtonText>Add/Edit Dependency Note</ButtonText></Strings>
      </Button>
      <Button guid="guidDeposCommands" id="OpenNotes" priority="0x0200" type="Button">
        <Parent guid="guidDeposCommands" id="DeposMenuGroup" />
        <Strings><ButtonText>Open NuGet Dependency Notes</ButtonText></Strings>
      </Button>
      <Button guid="guidDeposCommands" id="OpenManifest" priority="0x0300" type="Button">
        <Parent guid="guidDeposCommands" id="DeposMenuGroup" />
        <Strings><ButtonText>Open NuGet Dependency Manifest</ButtonText></Strings>
      </Button>
      <Button guid="guidDeposCommands" id="ShowCoverage" priority="0x0400" type="Button">
        <Parent guid="guidDeposCommands" id="DeposMenuGroup" />
        <Strings><ButtonText>Documentation Coverage</ButtonText></Strings>
      </Button>
      <Button guid="guidDeposCommands" id="ToggleMarkers" priority="0x0500" type="Button">
        <Parent guid="guidDeposCommands" id="DeposMenuGroup" />
        <Strings><ButtonText>Toggle Note Markers</ButtonText></Strings>
      </Button>
      <Button guid="guidDeposCommands" id="SetupAiInstructions" priority="0x0600" type="Button">
        <Parent guid="guidDeposCommands" id="DeposMenuGroup" />
        <Strings><ButtonText>Set Up AI Instructions</ButtonText></Strings>
      </Button>
      <Button guid="guidDeposCommands" id="NormalizeNotes" priority="0x0700" type="Button">
        <Parent guid="guidDeposCommands" id="DeposMenuGroup" />
        <Strings><ButtonText>Format NuGet Dependency Notes</ButtonText></Strings>
      </Button>
      <Button guid="guidDeposCommands" id="MoveNotes" priority="0x0800" type="Button">
        <Parent guid="guidDeposCommands" id="DeposMenuGroup" />
        <Strings>
          <ButtonText>Move Notes to .depos/</ButtonText>
          <ToolTipText>Move the notes from .pacmon/, their directory from before Pacmon became Depos, to .depos/</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidDeposCommands" id="SignIn" priority="0x0100" type="Button">
        <Parent guid="guidDeposCommands" id="DeposConnectionGroup" />
        <Strings>
          <ButtonText>Sign In</ButtonText>
          <ToolTipText>Sign in to use your organization's notes and allowlist</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidDeposCommands" id="SignOut" priority="0x0200" type="Button">
        <Parent guid="guidDeposCommands" id="DeposConnectionGroup" />
        <Strings>
          <ButtonText>Sign Out</ButtonText>
          <ToolTipText>End the sign-in and remove the local copy of your organization's notes and allowlist results</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidDeposCommands" id="ShowConnection" priority="0x0300" type="Button">
        <Parent guid="guidDeposCommands" id="DeposConnectionGroup" />
        <Strings>
          <ButtonText>Show Connection</ButtonText>
          <ToolTipText>Who you are signed in as, and the organization of each folder</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidDeposCommands" id="RefreshNotes" priority="0x0400" type="Button">
        <Parent guid="guidDeposCommands" id="DeposConnectionGroup" />
        <Strings>
          <ButtonText>Refresh Organization Notes</ButtonText>
          <ToolTipText>Ask the server for what changed in your organization's notes and allowlist</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidDeposCommands" id="CopyMcpSetup" priority="0x0500" type="Button">
        <Parent guid="guidDeposCommands" id="DeposConnectionGroup" />
        <Strings>
          <ButtonText>Copy MCP Setup</ButtonText>
          <ToolTipText>Copy an .mcp.json for AI agents, for the repository of a folder in org mode</ToolTipText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>
  <Symbols>
    <GuidSymbol name="guidDeposPackage" value="{0D148B7E-B648-46AA-92EF-E401D72AE221}" />
    <GuidSymbol name="guidDeposCommands" value="{A6EEA79E-0D28-481F-B55F-32E34EC61796}">
      <IDSymbol name="DeposMenuGroup" value="0x1000" />
      <IDSymbol name="DeposEditorGroup" value="0x1001" />
      <IDSymbol name="DeposConnectionGroup" value="0x1002" />
      <IDSymbol name="DeposToolsGroup" value="0x1003" />
      <IDSymbol name="DeposMenu" value="0x1004" />
      <IDSymbol name="ShowDepos" value="0x0100" />
      <IDSymbol name="AddOrEditNote" value="0x0101" />
      <IDSymbol name="OpenNotes" value="0x0102" />
      <IDSymbol name="ShowCoverage" value="0x0103" />
      <IDSymbol name="NormalizeNotes" value="0x0104" />
      <IDSymbol name="SetupAiInstructions" value="0x0105" />
      <IDSymbol name="ToggleMarkers" value="0x0106" />
      <IDSymbol name="OpenManifest" value="0x0107" />
      <IDSymbol name="SignIn" value="0x0108" />
      <IDSymbol name="SignOut" value="0x0109" />
      <IDSymbol name="ShowConnection" value="0x010A" />
      <IDSymbol name="RefreshNotes" value="0x010B" />
      <IDSymbol name="CopyMcpSetup" value="0x010C" />
      <IDSymbol name="MoveNotes" value="0x010D" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
