<idea-plugin url="https://depos.dev">
    <!-- The id is from before Pacmon became Depos, and stays: it is the plugin's
         identity on the Marketplace, so installed copies keep updating. -->
    <id>dev.pacmon.jetbrains</id>
    <name>Depos (formerly Pacmon)</name>
    <vendor email="info@depos.dev" url="https://depos.dev">Kontra</vendor>
    <!-- Display names for registrations whose ids stay from before the rename:
         the tool window and the notification group. -->
    <resource-bundle>messages.DeposBundle</resource-bundle>

    <!-- The Marketplace listing is built from the plugin zip: the name and the
         description here, META-INF/pluginIcon.svg next to this file, and the change
         notes, which build.gradle.kts renders from this version's CHANGELOG section.
         None of them can be edited on the site; a change ships as a new version.
         The url on <idea-plugin> is the homepage link on the plugin's Marketplace
         page, which the vendor's url does not fill. -->
    <description><![CDATA[
        <p><b>Your dependency manifest says what you depend on. Depos adds why.</b></p>
        <p>Every dependency gets a short note: why it is here, what must not change,
        what to check before an upgrade. The note shows in <code>package.json</code>,
        <code>Cargo.toml</code>, Maven <code>pom.xml</code>, a Gradle build file, <code>mix.exs</code>,
        <code>gleam.toml</code>, <code>build.zig.zon</code>, <code>pyproject.toml</code>, a pip requirements file, a .NET project file,
        <code>Gemfile</code>, a gemspec, <code>composer.json</code>, <code>Directory.Packages.props</code>, <code>go.mod</code>, <code>vcpkg.json</code>, <code>conanfile.py</code>, or <code>conanfile.txt</code> as quick documentation,
        and you write it from there.</p>
        <p>Notes are plain Markdown under <code>.depos/</code>, separated by ecosystem.
        No database, no service, no account: files that you read, diff and commit like
        any other. AI coding agents read the same files before they touch a package.
        A repository that keeps its notes under <code>.pacmon/</code>, their directory
        from before Pacmon became Depos, works as it is, and moves with
        <b>Move Notes to .depos/</b> once everyone working in it has updated.</p>
        <p>Optionally, sign in to your organization's Depos server: a folder whose GitHub
        repository is added to one of your organizations then shows the organization's
        notes, and marks packages its allowlist denies or has not decided on.</p>
        <ul>
            <li>Five ways into a note from a dependency manifest, each one you turn
            on or off: a mark at the dependency declaration — filled when it has a note,
            hollow when it does not — Ctrl+click on the name itself, a clickable line
            above the dependency, the words at the end of the line, and a lightbulb on
            the caret line. The first line of the note shows at the end of the line;
            the whole note shows as quick documentation.</li>
            <li>Write a note from the manifest in the Depos tool window or
            in a popup over the line, with a layer for people and a layer for agents.</li>
            <li><b>Documentation Coverage</b> lists which dependencies have a note and
            which do not.</li>
            <li>Problems in the notes file are underlined as you write, and
            <b>Format DEPENDENCY-NOTES.md</b> rewrites the file into canonical form.</li>
            <li><b>Set Up AI Instructions</b> writes the rules for AI coding agents to
            <code>.depos/AGENT-RULES.md</code> and points <code>AGENTS.md</code>,
            <code>CLAUDE.md</code> and similar files to it.</li>
        </ul>
        <p>Depos reads and writes files in your project and makes network requests
        only while you are signed in; it does not call any AI service. The
        <a href="https://marketplace.visualstudio.com/items?itemName=kontra.pacmon">VS Code
        extension</a> reads the same files, and the format is documented at
        <a href="https://depos.dev/format/">depos.dev/format</a>.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>
    <!-- Only to annotate DEPENDENCY-NOTES.md when the Markdown plugin claims
         .md files; without it they are plain text and the TEXT annotator runs. -->
    <depends optional="true" config-file="pacmon-markdown.xml">org.intellij.plugins.markdown</depends>
    <depends optional="true" config-file="pacmon-toml.xml">org.toml.lang</depends>
    <depends optional="true" config-file="pacmon-groovy.xml">org.intellij.groovy</depends>
    <depends optional="true" config-file="pacmon-kotlin.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="pacmon-elixir.xml">org.elixir_lang</depends>
    <depends optional="true" config-file="pacmon-zig.xml">com.falsepattern.zigbrains</depends>
    <depends optional="true" config-file="pacmon-python.xml">com.intellij.modules.python</depends>
    <depends optional="true" config-file="pacmon-ruby.xml">com.intellij.modules.ruby</depends>
    <depends optional="true" config-file="pacmon-go.xml">org.jetbrains.plugins.go</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
            parentId="tools"
            id="dev.pacmon.jetbrains.settings"
            displayName="Depos"
            instance="dev.pacmon.jetbrains.settings.PacmonConfigurable"/>
        <codeInsight.inlayProvider
            language="JSON"
            id="PacmonDependencyIcons"
            implementationClass="dev.pacmon.jetbrains.editor.PacmonInlayHintsProvider"/>
        <codeInsight.inlayProvider
            language="XML"
            id="PacmonDependencyIconsXml"
            implementationClass="dev.pacmon.jetbrains.editor.PacmonInlayHintsProvider"/>
        <codeInsight.inlayProvider
            language="TEXT"
            id="PacmonDependencyIconsText"
            implementationClass="dev.pacmon.jetbrains.editor.PacmonInlayHintsProvider"/>
        <editor.linePainter
            implementation="dev.pacmon.jetbrains.editor.PacmonLinePainter"/>
        <!-- The "link" click target: Ctrl+click a package name to open its note. -->
        <gotoDeclarationHandler
            implementation="dev.pacmon.jetbrains.editor.PacmonNoteDeclarationHandler"/>
        <!-- The "lightbulb" click target: nothing drawn until the caret is on the line.
             Registered once, for every language: the IDE refuses an intention class
             registered more than once (IntelliJ 2026.3 throws on it), and
             isAvailable() returns false outside a dependency manifest. -->
        <intentionAction>
            <className>dev.pacmon.jetbrains.editor.PacmonAddNoteIntention</className>
            <category>Depos</category>
        </intentionAction>
        <annotator
            language="TEXT"
            implementationClass="dev.pacmon.jetbrains.editor.PacmonNotesAnnotator"/>
        <!-- Org mode: the organization's allowlist result at the manifest line. One
             registration per manifest language, like the quick documentation; the
             optional language xmls add the rest. -->
        <annotator
            language="JSON"
            implementationClass="dev.pacmon.jetbrains.editor.PacmonAllowlistAnnotator"/>
        <annotator
            language="XML"
            implementationClass="dev.pacmon.jetbrains.editor.PacmonAllowlistAnnotator"/>
        <annotator
            language="TEXT"
            implementationClass="dev.pacmon.jetbrains.editor.PacmonAllowlistAnnotator"/>
        <!-- The Depos connection: sign-in codes, refused saves, the copied MCP setup;
             and the offer to move the notes to .depos/. The id stays from before the
             rename; Settings | Notifications shows the name from the bundle. -->
        <notificationGroup id="Pacmon" displayType="BALLOON" key="notification.group.depos"/>
        <!-- Org mode: a banner on DEPENDENCY-NOTES.md, which is not read then. -->
        <editorNotificationProvider implementation="dev.pacmon.jetbrains.editor.PacmonOrgModeNotificationProvider"/>
        <postStartupActivity implementation="dev.pacmon.jetbrains.depos.OrgStartupActivity"/>
        <lang.documentationProvider
            language="JSON"
            implementationClass="dev.pacmon.jetbrains.editor.PacmonDocumentationProvider"/>
        <lang.documentationProvider
            language="XML"
            implementationClass="dev.pacmon.jetbrains.editor.PacmonDocumentationProvider"/>
        <lang.documentationProvider
            language="TEXT"
            implementationClass="dev.pacmon.jetbrains.editor.PacmonDocumentationProvider"/>
        <!-- The id stays from before the rename, so the window keeps its place; its
             title is toolwindow.stripe.Pacmon in the bundle. -->
        <toolWindow
            id="Pacmon"
            anchor="right"
            icon="/icons/pacmon.svg"
            factoryClass="dev.pacmon.jetbrains.ui.PacmonToolWindowFactory"/>
    </extensions>

    <projectListeners>
        <!-- A notes file under .pacmon/ opened: Move Notes to .depos/, offered once per project. -->
        <listener
            class="dev.pacmon.jetbrains.action.MoveNotesSuggestion"
            topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <actions>
        <action
            id="Pacmon.AddOrEditNote"
            class="dev.pacmon.jetbrains.action.AddOrEditNoteAction"
            text="Add/Edit Dependency Note"
            description="Add or edit the note for this dependency"
            icon="/icons/pacmon.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action
            id="Pacmon.OpenPackageJson"
            class="dev.pacmon.jetbrains.action.OpenPackageJsonAction"
            text="Open package.json"
            description="Compatibility alias for Open Dependency Manifest"/>
        <!-- Tools > Depos: the plugin's actions under its name, as VS Code shows them
             under "Depos:". The ids are the ones from before Pacmon became Depos, so
             keymaps that name them still work. -->
        <group id="Pacmon.ToolsMenu" text="Depos" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action
                id="Pacmon.OpenNotesFile"
                class="dev.pacmon.jetbrains.action.OpenNotesFileAction"
                text="Open DEPENDENCY-NOTES.md"
                description="Open the dependency notes file"/>
            <action
                id="Pacmon.OpenManifest"
                class="dev.pacmon.jetbrains.action.OpenManifestAction"
                text="Open Dependency Manifest"
                description="Open the dependency manifest these notes describe"/>
            <action
                id="Pacmon.ShowCoverage"
                class="dev.pacmon.jetbrains.action.ShowCoverageAction"
                text="Documentation Coverage"
                description="Every dependency in one list, documented or not"/>
            <action
                id="Pacmon.ToggleNoteMarkers"
                class="dev.pacmon.jetbrains.action.ToggleNoteMarkersAction"
                text="Toggle Note Markers"
                description="Turn the end-of-line note hint off and back on"/>
            <action
                id="Pacmon.SetupAiInstructions"
                class="dev.pacmon.jetbrains.action.SetupAiInstructionsAction"
                text="Set Up AI Instructions"
                description="Write .depos/AGENT-RULES.md and point AGENTS.md, CLAUDE.md and similar files to it"/>
            <action
                id="Pacmon.NormalizeNotesFile"
                class="dev.pacmon.jetbrains.action.NormalizeNotesFileAction"
                text="Format DEPENDENCY-NOTES.md"
                description="Rewrite the dependency notes file into canonical form"/>
            <action
                id="Pacmon.MoveNotes"
                class="dev.pacmon.jetbrains.action.MoveNotesAction"
                text="Move Notes to .depos/"
                description="Move the notes from .pacmon/, their directory from before Pacmon became Depos, to .depos/"/>
            <separator/>
            <action
                id="Pacmon.Depos.SignIn"
                class="dev.pacmon.jetbrains.depos.SignInToDeposAction"
                text="Sign In"
                description="Sign in to use your organization's notes and allowlist"/>
            <action
                id="Pacmon.Depos.SignOut"
                class="dev.pacmon.jetbrains.depos.SignOutOfDeposAction"
                text="Sign Out"
                description="End the sign-in and remove the local copy of your organization's notes and allowlist results"/>
            <action
                id="Pacmon.Depos.ShowConnection"
                class="dev.pacmon.jetbrains.depos.ShowDeposConnectionAction"
                text="Show Connection"
                description="Who you are signed in as, and the organization of each folder"/>
            <action
                id="Pacmon.Depos.Refresh"
                class="dev.pacmon.jetbrains.depos.RefreshOrgNotesAction"
                text="Refresh Organization Notes"
                description="Ask the server for what changed in your organization's notes and allowlist"/>
            <action
                id="Pacmon.Depos.CopyMcpSetup"
                class="dev.pacmon.jetbrains.depos.CopyDeposMcpSetupAction"
                text="Copy MCP Setup"
                description="Copy an .mcp.json for AI agents, for the repository of a folder in org mode"/>
        </group>
    </actions>
</idea-plugin>
